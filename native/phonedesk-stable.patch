 void audio_renderer_flush() {
+    g_mutex_lock(&audio_mutex);
+    if(renderer && renderer->pipeline) {
+        /* READY clears appsrc, decoder, queue and audio-device ring buffers.
+         * Returning to PLAYING also restarts the running-time epoch. */
+        gst_element_set_state(renderer->pipeline,GST_STATE_READY);
+        gst_element_set_state(renderer->pipeline,GST_STATE_PLAYING);
+        gst_audio_pipeline_base_time=gst_element_get_base_time(renderer->appsrc);
+        next_discont=TRUE;
+        fprintf(stderr,"PhoneDesk audio: flush cleared queued audio\n");
+    }
+    g_mutex_unlock(&audio_mutex);
+}
