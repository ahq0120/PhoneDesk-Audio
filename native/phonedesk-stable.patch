+static void set_pipeline_sync(audio_renderer_t *target, gboolean enabled) {
+    g_object_set(target->appsrc,"do-timestamp",!enabled,
+        "max-buffers",(guint64)(enabled?600:60),
+        "max-time",(guint64)(enabled?3*GST_SECOND:600*GST_MSECOND),NULL);
+    g_object_set(target->pcm_queue,"max-size-buffers",(guint)(enabled?400:24),
+        "max-size-time",(guint64)(enabled?3*GST_SECOND:250*GST_MSECOND),NULL);
+    if(target->output_sink)g_object_set(target->output_sink,"sync",enabled,NULL);
+}
+
+void phonedesk_audio_set_sync(int enabled) {
+    g_mutex_lock(&audio_mutex);
+    async=vsync=enabled!=0;sync=enabled!=0;
+    if(renderer)gst_element_set_state(renderer->pipeline,GST_STATE_READY);
+    for(int i=0;i<NFORMATS;i++)if(renderer_type[i])set_pipeline_sync(renderer_type[i],enabled!=0);
+    /* The synthetic test renderer is independent of the format table. */
+    if(renderer){
+        set_pipeline_sync(renderer,enabled!=0);
+        gst_element_set_state(renderer->pipeline,GST_STATE_PLAYING);
+        gst_audio_pipeline_base_time=gst_element_get_base_time(renderer->appsrc);
+    }
+    next_discont=TRUE;
+    fprintf(stderr,"PhoneDesk audio: sync_mode=%d\n",enabled!=0);
+    g_mutex_unlock(&audio_mutex);
 }
 
