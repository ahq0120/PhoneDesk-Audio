+/* Diagnostic profiles are opt-in. Never log arbitrary sender strings. */
+static unsigned phonedesk_latency_us(unsigned fallback) {
+    const char *v=getenv("PHONEDESK_RESEARCH_LATENCY_MS");
+    if(!v)return fallback;
+    if(!strcmp(v,"0"))return 0;
+    if(!strcmp(v,"80"))return 80000;
+    if(!strcmp(v,"250"))return 250000;
+    return fallback;
+}
+static plist_t phonedesk_output_latency(void) {
+    if(getenv("PHONEDESK_RESEARCH_LATENCY_MS"))
+        return plist_new_uint(phonedesk_latency_us(0));
+    return plist_new_bool(0); /* unchanged baseline */
+}
+static void phonedesk_mode(plist_t dict,const char *scope) {
+    plist_t node=plist_dict_get_item(dict,"audioMode");
+    char *value=NULL;
+    if(node && plist_get_node_type(node)==PLIST_STRING)plist_get_string_val(node,&value);
+    const char *mode="other";
+    if(!value)mode="absent";
+    else if(!strcmp(value,"default"))mode="default";
+    else if(!strcmp(value,"moviePlayback"))mode="moviePlayback";
+    else if(!strcmp(value,"media"))mode="media";
+    else if(!strcmp(value,"videoChat"))mode="videoChat";
+    fprintf(stderr,"PhoneDesk audio: audio_mode scope=%s value=%s present=%d\n",scope,mode,node!=NULL);
+    if(value)plist_mem_free(value);
+}
